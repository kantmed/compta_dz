<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_accounting_folder" model="ir.ui.view">
        <field name="name">account.payment.form.accounting.folder</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="ca_accounting_folder_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
