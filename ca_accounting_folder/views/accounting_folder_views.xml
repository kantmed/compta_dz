<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_account_moves_by_folder" model="ir.actions.act_window">
        <field name="name">Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ca_accounting_folder_id', '=', active_id)]</field>
        <field name="context">{'default_ca_accounting_folder_id': active_id}</field>
    </record>

    <record id="view_ca_accounting_folder_form_accounting" model="ir.ui.view">
        <field name="name">ca.accounting.folder.form.accounting</field>
        <field name="model">ca.accounting.folder</field>
        <field name="inherit_id" ref="ca_core.view_ca_accounting_folder_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="%(action_account_moves_by_folder)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-book">
                        <span class="o_stat_text">Journal Entries</span>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
