<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_collaboration_document_request_list" model="ir.ui.view">
        <field name="name">ca.collaboration.document.request.list</field>
        <field name="model">ca.collaboration.document.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="collaboration_id"/>
                <field name="requester_id"/>
                <field name="recipient_id"/>
                <field name="state"/>
                <field name="date_due"/>
            </list>
        </field>
    </record>

    <record id="view_ca_collaboration_document_request_form" model="ir.ui.view">
        <field name="name">ca.collaboration.document.request.form</field>
        <field name="model">ca.collaboration.document.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Send" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start" invisible="state != 'sent'"/>
                    <button name="action_receive" type="object" string="Receive" invisible="state not in ('sent', 'in_progress')"/>
                    <button name="action_validate" type="object" string="Validate" invisible="state != 'received'"/>
                    <button name="action_refuse" type="object" string="Refuse" invisible="state != 'received'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('validated', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,in_progress,received,validated,refused,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <field name="reference" readonly="1"/>
                        <field name="name"/>
                        <field name="collaboration_id"/>
                        <field name="requester_id"/>
                        <field name="recipient_id"/>
                        <field name="date_request"/>
                        <field name="date_due"/>
                        <field name="date_response"/>
                    </group>
                    <group>
                        <field name="requested_description"/>
                        <field name="comment"/>
                    </group>
                    <group>
                        <field name="transmitted_document_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ca_collaboration_document_request_search" model="ir.ui.view">
        <field name="name">ca.collaboration.document.request.search</field>
        <field name="model">ca.collaboration.document.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="collaboration_id"/>
                <field name="recipient_id"/>
                <filter string="Pending" name="pending" domain="[('state', 'in', ('sent', 'in_progress', 'received'))]"/>
                <filter string="Validated" name="validated" domain="[('state', '=', 'validated')]"/>
            </search>
        </field>
    </record>

    <record id="action_ca_collaboration_document_request" model="ir.actions.act_window">
        <field name="name">Document Requests</field>
        <field name="res_model">ca.collaboration.document.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
