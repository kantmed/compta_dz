<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_collaboration_message_list" model="ir.ui.view">
        <field name="name">ca.collaboration.message.list</field>
        <field name="model">ca.collaboration.message</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="collaboration_id"/>
                <field name="author_id"/>
                <field name="message_type"/>
                <field name="body"/>
                <field name="is_read"/>
            </list>
        </field>
    </record>

    <record id="view_ca_collaboration_message_form" model="ir.ui.view">
        <field name="name">ca.collaboration.message.form</field>
        <field name="model">ca.collaboration.message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="collaboration_id"/>
                        <field name="task_id"/>
                        <field name="request_id"/>
                        <field name="author_id"/>
                        <field name="recipient_ids" widget="many2many_tags"/>
                        <field name="message_type"/>
                        <field name="date"/>
                        <field name="is_read"/>
                        <field name="read_date"/>
                    </group>
                    <group>
                        <field name="body"/>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ca_collaboration_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">ca.collaboration.message</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
