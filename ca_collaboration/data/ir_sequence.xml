<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <data>
        <record id="seq_ca_collaboration" model="ir.sequence">
            <field name="name">Collaboration</field>
            <field name="code">ca.collaboration</field>
            <field name="prefix">COL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_ca_collaboration_task" model="ir.sequence">
            <field name="name">Collaboration Task</field>
            <field name="code">ca.collaboration.task</field>
            <field name="prefix">TASK/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_ca_collaboration_document_request" model="ir.sequence">
            <field name="name">Collaboration Document Request</field>
            <field name="code">ca.collaboration.document.request</field>
            <field name="prefix">DOC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
