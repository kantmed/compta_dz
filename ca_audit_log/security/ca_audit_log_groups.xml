<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_ca_audit_log_user" model="res.groups">
            <field name="name">User</field>
            <field name="comment">Consultation of own audit logs.</field>
        </record>

        <record id="group_ca_audit_log_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="comment">Consultation of audit logs in the authorized companies.</field>
            <field name="implied_ids" eval="[(4, ref('ca_audit_log.group_ca_audit_log_user'))]"/>
        </record>

        <record id="group_ca_audit_log_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="comment">Functional administration of audit logs.</field>
            <field name="implied_ids" eval="[(4, ref('ca_audit_log.group_ca_audit_log_manager'))]"/>
        </record>
    </data>
</odoo>
