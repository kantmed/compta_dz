<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_activity_category_list" model="ir.ui.view">
        <field name="name">ca.activity.category.list</field>
        <field name="model">ca.activity.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="name_ar"/>
                <field name="name_en"/>
                <field name="parent_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ca_activity_category_form" model="ir.ui.view">
        <field name="name">ca.activity.category.form</field>
        <field name="model">ca.activity.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="name_ar"/>
                        <field name="name_en"/>
                        <field name="parent_id"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ca_activity_category_search" model="ir.ui.view">
        <field name="name">ca.activity.category.search</field>
        <field name="model">ca.activity.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="name_ar"/>
                <field name="name_en"/>
                <field name="parent_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_ca_activity_category" model="ir.actions.act_window">
        <field name="name">Activity Categories</field>
        <field name="res_model">ca.activity.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
