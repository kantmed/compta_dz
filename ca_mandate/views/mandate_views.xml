<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_mandate_list" model="ir.ui.view">
        <field name="name">ca.mandate.list</field>
        <field name="model">ca.mandate</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="firm_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="is_primary"/>
            </list>
        </field>
    </record>

    <record id="view_ca_mandate_form" model="ir.ui.view">
        <field name="name">ca.mandate.form</field>
        <field name="model">ca.mandate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Validate" invisible="state != 'pending'"/>
                    <button name="action_suspend" type="object" string="Suspend" invisible="state != 'active'"/>
                    <button name="action_resume" type="object" string="Resume" invisible="state != 'suspended'"/>
                    <button name="action_done" type="object" string="Done" invisible="state not in ('active', 'suspended')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'pending', 'active', 'suspended')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,active,suspended,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="firm_id"/>
                            <field name="is_primary"/>
                        </group>
                        <group>
                            <field name="date_signature"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="date_end_effective"/>
                            <field name="manager_id"/>
                            <field name="client_manager_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="mission_ids" widget="many2many_tags"/>
                        <field name="folder_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="collaborator_ids"/>
                    </group>
                    <group>
                        <field name="document_ids" widget="many2many_binary"/>
                    </group>
                    <group>
                        <field name="previous_mandate_id"/>
                        <field name="successor_mandate_id"/>
                    </group>
                    <group>
                        <field name="notes"/>
                        <field name="suspension_reason"/>
                        <field name="termination_reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ca_mandate_search" model="ir.ui.view">
        <field name="name">ca.mandate.search</field>
        <field name="model">ca.mandate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="company_id"/>
                <field name="firm_id"/>
                <field name="manager_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Suspended" name="suspended" domain="[('state', '=', 'suspended')]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Firm" name="group_firm" context="{'group_by': 'firm_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ca_mandate" model="ir.actions.act_window">
        <field name="name">Mandates</field>
        <field name="res_model">ca.mandate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
