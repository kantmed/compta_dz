<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_mandate_mission_list" model="ir.ui.view">
        <field name="name">ca.mandate.mission.list</field>
        <field name="model">ca.mandate.mission</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="name_ar"/>
                <field name="name_en"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ca_mandate_mission_form" model="ir.ui.view">
        <field name="name">ca.mandate.mission.form</field>
        <field name="model">ca.mandate.mission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="name_ar"/>
                        <field name="name_en"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ca_mandate_mission" model="ir.actions.act_window">
        <field name="name">Missions</field>
        <field name="res_model">ca.mandate.mission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
